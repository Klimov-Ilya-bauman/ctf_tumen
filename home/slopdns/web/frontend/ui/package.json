{
  "name": "slopdns-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript ../../../api/openapi.yaml -o src/api/generated/schema.ts",
    "dev": "npm run gen:api && vite",
    "dev:mock": "npm run gen:api && msw init .mock-public --save && vite --mode mock",
    "prebuild": "npm run gen:api",
    "build": "tsc --noEmit && vite build",
    "pretypecheck": "npm run gen:api",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "pretest": "npm run gen:api",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.0",
    "punycode": "^2.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0",
    "tr46": "^5.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/punycode": "^2.1.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/tr46": "^5.0.1",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.0",
    "openapi-typescript": "^7.8.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.34.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.0"
  },
  "msw": {
    "workerDirectory": [
      ".mock-public"
    ]
  }
}
